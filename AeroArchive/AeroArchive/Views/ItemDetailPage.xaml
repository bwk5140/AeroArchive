<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AeroArchive.Views.ItemDetailPage"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Edit" Command="{Binding EditItemCommand}" />
        <ToolbarItem Text="Delete" Command="{Binding DeleteItemCommand}" />
    </ContentPage.ToolbarItems>

    <StackLayout Spacing="20" Padding="15">
        <Label Text="Product ID:" FontSize="Medium" 
               Style="{DynamicResource ListItemTextStyle}"/>
        <Label Text="{Binding Text}" FontSize="Small"
               Style="{DynamicResource ListItemDetailTextStyle}"/>
        <Label Text="Warranty Status:" FontSize="Medium" 
               Style="{DynamicResource ListItemTextStyle}"/>
        <Label Text="{Binding WarrantyStatus}" FontSize="Small"
               Style="{DynamicResource ListItemDetailTextStyle}"/>
        <Label Text="Description:" FontSize="Medium" 
               Style="{DynamicResource ListItemTextStyle}"/>
        <Label Text="{Binding Description}" FontSize="Small"
               Style="{DynamicResource ListItemDetailTextStyle}"/>
    </StackLayout>

</ContentPage>