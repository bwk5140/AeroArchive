<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AeroArchive.Views.LoginPage"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary Source="../Resources/Fonts/FontRD.xaml" />
        <ResourceDictionary Source="../Resources/Fonts/EntryValidationRD.xaml" />
        <StyleSheet Source="../Styles/LoginPage.css" />
    </ContentPage.Resources>

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <FlexLayout x:Name="Form" StyleClass="body">
            <StackLayout x:Name="LoginForm" StyleClass="container">
                <Label StyleClass="logo" Text="Sign in" TextColor="DarkSlateGray" />
                <FlexLayout StyleClass="login-form">
                    <Entry
                        x:Name="UserNameEntry"
                        IsSpellCheckEnabled="false"
                        MaxLength="7"
                        Placeholder="UserName"
                        PlaceholderColor="DarkSlateGray"
                        Text="{Binding UserName}"
                        TextColor="DarkSlateGray" 
                        TextChanged="Handle_TextChanged"/>
                    <Entry
                        x:Name="PasswordEntry"
                        IsPassword="true"
                        Placeholder="Password"
                        PlaceholderColor="DarkSlateGray"
                        TextChanged="Handle_TextChanged"
                        TextColor="DarkSlateGray" />

                    <Label
                        x:Name="StrengthIndicator"
                        FontSize="24"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource FAStyle}"
                        StyleClass="strength"
                        Text="" />

                    <Button Clicked="OnLoginClicked" Text="Login" 
                            TextColor="WhiteSmoke"/>
                </FlexLayout>
                
                <StackLayout
                        Margin="50,10"
                        IsVisible="True"
                        Orientation="Horizontal">
                    <Label Text="Remember Me:"
                               TextColor="DarkSlateGray"/>
                    <Switch IsToggled="{Binding RememberMe}" />
                </StackLayout>

                <Label
                    x:Name="LabelForgotPassword"
                    Grid.Row="2"
                    Margin="10"
                    HorizontalOptions="Center"
                    Text="Forgot Password?"
                    TextColor="DodgerBlue"
                    TextDecorations="Underline">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ForgotPasswordTapped" />
                    </Label.GestureRecognizers>
                </Label>

                <Label 
                    Grid.Row="3"
                    Margin="10"
                    Text="Register"
                    HorizontalOptions="Center"
                    TextColor="DodgerBlue">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="RegisterTapped"/>
                    </Label.GestureRecognizers>
                </Label>
                
            </StackLayout>
        </FlexLayout>
        
        <Label
            x:Name="LabelConnection"
            Grid.Row="1"
            Margin="10"
            HorizontalOptions="Center"
            IsVisible="False"
            Opacity="0"
            Text="Disconnected" 
            TextColor="#5D98B8"/>
    </Grid>
</ContentPage>