<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AeroArchive.ViewModels"
             x:DataType="viewmodels:RegistrationViewModel"
             x:Class="AeroArchive.Views.RegistrationPage"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False">
    <AbsoluteLayout>
        <StackLayout AbsoluteLayout.LayoutBounds="1, 0.5, 1,0.5"    
                     AbsoluteLayout.LayoutFlags="All"    
                     HorizontalOptions="Center"    
                     VerticalOptions="Center"
                     BackgroundColor="#EFFBFF"
                     Padding="50">
            <StackLayout
                Orientation="Horizontal"
                WidthRequest="400" HorizontalOptions="Center">
                <Entry
                    Placeholder="First Name"
                    HorizontalOptions="FillAndExpand"
                    Margin="20,5,20,10"
                    PlaceholderColor="#5D98B8"
                    BackgroundColor="#EFFBFF"/>
                <Entry 
                    Placeholder="Last Name"
                    HorizontalOptions="FillAndExpand"
                    Margin="20,5,20,10"
                    PlaceholderColor="#5D98B8"
                    BackgroundColor="#EFFBFF"/>
            </StackLayout>
            <StackLayout
                WidthRequest="400" HorizontalOptions="Center"
                Orientation="Vertical">
                <Entry Placeholder="Username"
                       HorizontalOptions="FillAndExpand"
                       Margin="20,5,20,10"
                       PlaceholderColor="#5D98B8"
                       BackgroundColor="#EFFBFF">

                </Entry>
                <Entry Placeholder="Email"
                       HorizontalOptions="FillAndExpand"
                       Margin="20,5,20,10"
                       PlaceholderColor="#5D98B8"
                       BackgroundColor="#EFFBFF">

                </Entry>
            </StackLayout>
            <StackLayout 
                WidthRequest="400" HorizontalOptions="Center">
                <Entry IsPassword="True" Placeholder="Password"
                       HorizontalOptions="FillAndExpand"
                       Margin="20,5,20,10"
                       PlaceholderColor="#5D98B8"
                       BackgroundColor="#EFFBFF"/>
            </StackLayout>
            <StackLayout>
                <Button Text="Create new account" Command="{Binding RegistrationCommand}"
                        Margin="20,5,20,10"
                        Button.BackgroundColor="#00C0FF"
                        Button.TextColor="#E6F4F1"/>
            </StackLayout>
        </StackLayout>
    </AbsoluteLayout>
</ContentPage>