<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AeroArchive.Views.AccountDetailsPage"
             Title="{Binding Title}">

    <StackLayout Spacing="20" Padding="15">
        <Label Text="First Name:" FontSize="Medium" 
               Style="{DynamicResource ListItemTextStyle}"/>
        <Label Text="{Binding FirstName}" FontSize="Small"
               Style="{DynamicResource ListItemDetailTextStyle}"/>
        <Label Text="Last Name:" FontSize="Medium" 
               Style="{DynamicResource ListItemTextStyle}"/>
        <Label Text="{Binding LastName}" FontSize="Small"
               Style="{DynamicResource ListItemDetailTextStyle}"/>
        <Label Text="Username:" FontSize="Medium"
               Style="{DynamicResource ListItemTextStyle}"/>
        <Label Text="{Binding UserName}" FontSize="Small"
               Style="{DynamicResource ListItemDetailTextStyle}"/>
        <Label Text="Email:" FontSize="Medium" 
               Style="{DynamicResource ListItemTextStyle}"/>
        <Label Text="{Binding Email}" FontSize="Small"
               Style="{DynamicResource ListItemDetailTextStyle}"/>
        <Label Text="Password:" FontSize="Medium"
               Style="{DynamicResource ListItemTextStyle}"/>
        <Label Text="{Binding Password}" FontSize="Small"
               Style="{DynamicResource ListItemDetailTextStyle}"
               IsVisible="False"/>
    </StackLayout>
</ContentPage>